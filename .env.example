# Enabled only on the existing D1/R2 storage service, never on Vercel.
STORAGE_BRIDGE_ENABLED=
# Canonical storefront URL; public, not a secret.
NEXT_PUBLIC_SITE_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
